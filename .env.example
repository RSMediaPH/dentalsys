# Copy to .env and adjust. All values are optional; defaults shown.
# DATA_DIR=data                         # database + attachments
# BACKUP_DIR=data/backups               # put this on a SECOND disk / USB drive in production
# BACKUP_KEY_FILE=data/keys/backup.key  # keep a copy OFF this computer
# BACKUP_RETENTION=14
# BACKUP_DAILY_AT=21:00                 # server local time; empty to disable
# HOST=127.0.0.1                        # 0.0.0.0 = reachable from other computers on the clinic network
# DEMO_MODE=false                       # true = 'TEST SYSTEM' banner on every page
# PORT=8080
# TLS_CERT_FILE=                        # required in production (see docs/08-deployment.md)
# TLS_KEY_FILE=
# SESSION_IDLE_MINUTES=60
# SESSION_ABSOLUTE_HOURS=12

# Development only: password for the synthetic demo accounts created by `npm run seed:demo`.
DEMO_PASSWORD=demo-clinic-2026
